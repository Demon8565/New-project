# Solana RPC — Helius
# Either set HELIUS_API_KEY (RugCanary builds the mainnet URL for you)...
HELIUS_API_KEY=
# ...or set the full RPC URL directly (takes precedence if both are set).
HELIUS_RPC_URL=

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:3001

# PostHog analytics (optional — analytics no-ops if unset)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
# Exposed to the browser bundle (same project key, but public-facing).
POSTHOG_CLIENT_KEY=

# SQLite path for the waitlist table (defaults to ./data/rugcanary.db)
DATABASE_PATH=
